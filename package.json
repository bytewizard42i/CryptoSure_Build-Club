{
  "name": "cryptosure-build-club",
  "version": "0.1.0",
  "private": true,
  "description": "CryptoSure Build Club MVP: validate the user, validate the wallet, bind one insurance policy to one wallet on Midnight.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "compact compile contracts/WalletBinder.compact build/walletbinder",
    "compile:fast": "compact compile --skip-zk contracts/WalletBinder.compact build/walletbinder",
    "oracles": "node scripts/oracle-processes.mjs",
    "demo": "node sandwich/run-demo.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0"
  }
}
