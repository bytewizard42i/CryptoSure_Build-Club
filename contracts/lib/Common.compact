// ============================================================================
// lib/Common.compact — keys and roles shared by every CryptoSure contract
// ============================================================================
//
// WHAT THIS FILE IS
//   An INCLUDE file, not a contract. Each contract pulls it in with
//       include "lib/Common";      (relative to the contract; the compiler adds .compact)
//   and the compiler splices these declarations into that contract as if they
//   had been typed there. Every contract therefore gets its OWN copy of the
//   ledger fields below; nothing is shared on-chain between contracts.
//   Reference: Compact language reference, "Include files".
//
// WHY IT EXISTS
//   Every contract needs the same two things: "who is calling?" and "are they
//   allowed to?". Writing that once means a fix lands everywhere.
//
// HOW A CALLER IS IDENTIFIED
//   Midnight has no msg.sender. A caller proves who they are by knowing a
//   secret key. The contract asks the caller's device for it through the
//   `local_secret_key` witness, hashes it, and compares the hash with the keys
//   it has on file. The secret itself never leaves the device or the proof.
//
// THE ROLE THIS FILE DEFINES
//   admin     configures the contract and appoints operators
//
//   The OPERATOR role (the outside party a contract trusts to feed it facts)
//   lives in lib/Operator.compact and is included only by the five check
//   contracts. It used to live here, which gave the three contracts that
//   take no outside facts an operator set and two role circuits that nothing
//   could ever use. The Nov 25 2026 review flagged that dead surface; a
//   contract that does not include lib/Operator now provably has no
//   operator. A contract that includes lib/Operator must include THIS file
//   first.
//
// IDEAS, NOT BUILT
//   - two-step admin handover (propose, then accept)
//   - M-of-N admin approval for sensitive changes (see the multi-party
//     authorization pattern in Midnight Expert's governance patterns)
//   - an on-chain log of role changes for auditors
// ============================================================================

// The caller's secret key, supplied by their own device. NEVER disclosed.
witness local_secret_key(): Bytes<32>;

// Who may configure this contract.
export ledger admins: Set<Bytes<32>>;

// How many admins there are. Kept so the last one can never be removed.
export ledger adminCount: Uint<64>;

// The public key that represents a ROLE holder (admin or operator).
// The text prefix is a "domain separator": it guarantees this hash can never
// collide with a hash computed for a different purpose from the same secret.
export circuit derive_role_key(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "cryptosure:role:pk:"),
    sk
  ]);
}

// The public key that represents a HOLDER (the person being cleared).
// A different prefix from the role key, so the same secret used in both
// roles produces two unrelated public keys.
export circuit derive_holder_key(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "cryptosure:holder:pk:"),
    sk
  ]);
}

circuit caller_role_key(): Bytes<32> {
  return derive_role_key(local_secret_key());
}

circuit assert_is_admin(): [] {
  assert(admins.member(disclose(caller_role_key())), "Caller is not an admin");
}

// Called by every contract's constructor. The first admin is fixed at the
// moment of deployment, as an argument, so there is no window in which a
// stranger could claim a freshly deployed contract.
// (An earlier version had a separate "claim" step that the first caller won.
// The Nov 25 2026 security review flagged it; it is gone.)
circuit install_first_admin(admin_key: Bytes<32>): [] {
  admins.insert(disclose(admin_key));
  adminCount = 1;
}

// add_admin and remove_admin are ONE circuit with a selector, not two.
// Every exported impure circuit costs a verifier key in the deployment
// transaction, and the chain allows only ~32 KB of writes per transaction
// (see deploy/THROTTLE.md). This merge and its twin in lib/Operator are
// what keep even the largest contract under that ceiling. The rules are
// unchanged: only an admin may call it, an admin cannot be added twice,
// and the last admin cannot be removed, or the contract could never be
// configured again.
export circuit set_admin(admin_key: Bytes<32>, enabled: Boolean): [] {
  assert_is_admin();
  const k = disclose(admin_key);
  if (disclose(enabled)) {
    assert(!admins.member(k), "That key is already an admin");
    admins.insert(k);
    adminCount = (adminCount + 1) as Uint<64>;
  } else {
    assert(admins.member(k), "That key is not an admin");
    assert(adminCount > 1, "The last admin cannot be removed");
    admins.remove(k);
    adminCount = (adminCount - 1) as Uint<64>;
  }
}
