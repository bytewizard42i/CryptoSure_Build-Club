# ============================================================================
# deploy/.env.example — settings the deploy scripts read from the environment
# ============================================================================
# Copy this file to ".env" (which is git-ignored) and uncomment what you need.
# The npm scripts load ".env" automatically if it exists.
# EVERYTHING HERE IS OPTIONAL for Preview. Never put a wallet seed in a file
# inside this repository: only the PATH to the seed file goes here.
# ============================================================================

# Path to a file whose LAST line is the deployer wallet's 64-hex-character seed.
# Default: /home/js/utils_Midnight/preProd-Wallets/tdust-secrets/sarah.seed
# CRYPTOSURE_DEPLOYER_SEED_FILE=/path/outside/the/repo/deployer.seed

# Which network the scripts use when no "--network <name>" is given.
# One of: preview (default), local, preprod (UNTESTED).
# CRYPTOSURE_NETWORK=preview

# Where the proof server listens. Default: http://127.0.0.1:6300
# CRYPTOSURE_PROOF_SERVER_URL=http://127.0.0.1:6300

# A different program configuration file. Default: ../config/program.json
# CRYPTOSURE_PROGRAM_CONFIG=/path/to/program.json

# Needed ONLY for preprod, which Blockfrost serves. Get one at blockfrost.io
# (a "Midnight Preprod" project). It is a credential: keep it out of git.
# BLOCKFROST_MIDNIGHT_PREPROD_PROJECT_ID=
